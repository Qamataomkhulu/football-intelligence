# Copy this file to .env and fill in real values locally.
# In GitHub Actions, set these as repository Secrets instead - never commit
# real keys to the repo (see .gitignore).

# Sportmonks Football API - fixtures, odds, lineups, xG, injuries, transfers, news
SPORTMONKS_API_KEY=

# The Odds API - secondary odds source for best/average/worst price comparison
ODDS_API_KEY=

# GDELT requires no API key.

# Database (defaults to local SQLite if unset)
DATABASE_URL=sqlite:///./football_intelligence.db

# Frontend -> backend API base URL (used once the FastAPI backend is
# deployed separately; the bundled frontend reads data/predictions/*.json
# directly from disk by default, so this is optional for local dev)
NEXT_PUBLIC_API_URL=http://localhost:8000
